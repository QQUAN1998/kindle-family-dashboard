{
  "name": "kindle-family-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source Kindle e-ink family dashboard with a CloudBase phone editor",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "build": "node scripts/build-site.js",
    "prepare:function": "npm install --prefix functions/kd_api --omit=dev --include=optional --ignore-scripts --force",
    "check": "npm run test && npm run lint && npm run build",
    "preview": "node scripts/render-preview.js"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.18.1",
    "@resvg/resvg-js": "^2.6.2",
    "lunar-javascript": "^1.7.7"
  },
  "devDependencies": {
    "eslint": "^9.35.0"
  },
  "engines": {
    "node": ">=24"
  }
}
